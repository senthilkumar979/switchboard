{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm --filter @switchboard-js/web build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "vitepress",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "pnpm build",
      "outputDirectory": ".vitepress/dist"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": { "service": "docs", "path": "/" }
    },
    {
      "source": "/docs/(.*)",
      "destination": { "service": "docs", "path": "/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}

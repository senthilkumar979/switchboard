{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@switchboard-js/web",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    },
    "docs": {
      "root": "apps/docs",
      "framework": "vitepress",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "pnpm build",
      "outputDirectory": ".vitepress/dist",
      "rewrites": [
        { "source": "/docs", "destination": "/index.html" },
        { "source": "/docs/", "destination": "/index.html" },
        { "source": "/docs/:path(.*)", "destination": "/:path" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": { "service": "docs" }
    },
    {
      "source": "/docs/(.*)",
      "destination": { "service": "docs" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}

{
  "name": "@switchboard-js/api-mock",
  "version": "0.1.0",
  "description": "Fetch interception for Switchboard API mocks",
  "license": "MIT",
  "author": "Switchboard Contributors",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "switchboard",
    "api-mock",
    "fetch",
    "mocking",
    "devtools",
    "scenarios"
  ],
  "homepage": "https://github.com/senthilkumar979/switchboard/tree/main/packages/api-mock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senthilkumar979/switchboard.git",
    "directory": "packages/api-mock"
  },
  "bugs": {
    "url": "https://github.com/senthilkumar979/switchboard/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@switchboard-js/core": "workspace:*"
  },
  "devDependencies": {
    "@switchboard-js/eslint-config": "workspace:*",
    "@switchboard-js/tsconfig": "workspace:*",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
